#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row"; // Cambiar a "row2col" si orientaste los diodos al revés

        // Filas: F0 (P0.17), F1 (P0.20), F2 (P0.22), F3 (P0.24), F4 (P1.00)
        row-gpios
            = <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1  0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

        // Columnas: C0 (P0.09) a C9 (P0.11)
        col-gpios
            = <&gpio0  9 GPIO_ACTIVE_HIGH> // C0
            , <&gpio0 10 GPIO_ACTIVE_HIGH> // C1
            , <&gpio1 11 GPIO_ACTIVE_HIGH> // C2
            , <&gpio1 13 GPIO_ACTIVE_HIGH> // C3
            , <&gpio1 15 GPIO_ACTIVE_HIGH> // C4
            , <&gpio0  2 GPIO_ACTIVE_HIGH> // C5
            , <&gpio0 29 GPIO_ACTIVE_HIGH> // C6
            , <&gpio0 31 GPIO_ACTIVE_HIGH> // C7
            , <&gpio1  4 GPIO_ACTIVE_HIGH> // C8
            , <&gpio0 11 GPIO_ACTIVE_HIGH> // C9
            ;
    };

    // Configuración del Encoder KY-040
    encoder: encoder {
        compatible = "alps,ec11";
        label = "ENCODER";
        a-gpios = <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; // Pin A (CLK) -> P0.06
        b-gpios = <&gpio0 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; // Pin B (DT)  -> P0.08
        steps = <80>;
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <20>;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <5>;
        map = <
            RC(0,7) RC(0,8)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9)
            RC(4,0) RC(4,1) RC(4,3)         RC(4,5)                 RC(4,7) RC(4,9)
        >;
    };
};
